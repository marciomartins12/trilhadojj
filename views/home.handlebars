<script>
  (function () {
    const list = document.getElementById('perksList');
    const actions = document.getElementById('perksActions');
    if (!list || !actions) return;

    const expandBtn = actions.querySelector('[data-perks-action="expand"]');
    const collapseBtn = actions.querySelector('[data-perks-action="collapse"]');
    const countEl = document.getElementById('perksCount');
    const totalItems = list.querySelectorAll('li').length;
    if (countEl && totalItems) {
      countEl.textContent = `+${totalItems} itens exclusivos`;
    }

    function isMobile() {
      return window.matchMedia('(max-width: 767px)').matches;
    }

    function setCollapsed() {
      list.classList.add('is-collapsed');
      list.classList.remove('is-expanded');
      expandBtn?.removeAttribute('aria-hidden');
      collapseBtn?.setAttribute('aria-hidden', 'true');
    }

    function setExpanded() {
      list.classList.remove('is-collapsed');
      list.classList.add('is-expanded');
      expandBtn?.setAttribute('aria-hidden', 'true');
      collapseBtn?.removeAttribute('aria-hidden');
    }

    function syncStateOnResize() {
      if (isMobile()) {
        if (!list.classList.contains('is-expanded')) setCollapsed();
        actions.style.display = '';
      } else {
        list.classList.remove('is-collapsed');
        list.classList.add('is-expanded');
        actions.style.display = 'none';
      }
    }

    expandBtn?.addEventListener('click', function () {
      if (!isMobile()) return;
      setExpanded();
      const items = list.querySelectorAll('li');
      if (items[4]) items[4].focus?.();
    });
    collapseBtn?.addEventListener('click', function () {
      if (!isMobile()) return;
      setCollapsed();
      expandBtn.focus?.();
    });

    window.addEventListener('resize', syncStateOnResize);
    syncStateOnResize();
  })();
</script>
<script>
  (function () {
    const root = document.getElementById('medalShowcase');
    const stage = document.getElementById('medalStage');
    const flipper = document.getElementById('medalFlipper');
    const flipBtn = document.getElementById('medalFlipBtn');
    if (!root || !stage || !flipper) return;

    const TURN_DEG = 360;          // giro (volta completa) conforme a medalha atravessa a viewport
    const DRAG_SENSITIVITY = 0.65; // graus por pixel arrastado
    const DRAG_THRESHOLD = 5;      // px para decidir a direção do gesto (horizontal x vertical)
    const FRICTION = 0.94;         // atrito da inércia (0..1)
    const MIN_VELOCITY = 0.05;     // abaixo disso, para

    let manualSpin = 0;   // giro acumulado pelo arraste + inércia
    let velocity = 0;     // graus por frame (para a inércia)
    let dragging = false;
    let gestureAxis = null; // null | 'x' (girar) | 'y' (rolar a página)
    let startX = 0;
    let startY = 0;
    let lastX = 0;
    let inertiaRaf = null;

    let inView = false;       // a medalha está (perto de estar) visível?
    let loopRaf = null;       // id do loop de render
    let lastApplied = null;   // último valor aplicado (evita escritas repetidas)

    // Progresso (0..1) conforme a medalha atravessa a viewport
    function progress() {
      const rect = stage.getBoundingClientRect();
      const vh = window.innerHeight || document.documentElement.clientHeight || 0;
      const total = vh + rect.height;
      if (total <= 0) return 0;
      const p = (vh - rect.top) / total;
      return p < 0 ? 0 : (p > 1 ? 1 : p);
    }

    // Desenha o giro: posição do scroll + giro manual (arraste/inércia).
    // Roda em loop de requestAnimationFrame enquanto a medalha está visível.
    // NÃO usamos o evento "scroll" porque nesta página o scroll acontece no
    // <body> (por causa de "html, body { height:100% }"), e esse evento não
    // chega ao window — era isso que deixava a medalha parada ao rolar.
    function render() {
      const p = progress();
      const total = (p - 0.5) * TURN_DEG + manualSpin;
      const value = total.toFixed(2) + 'deg';
      if (value !== lastApplied) {
        lastApplied = value;
        root.style.setProperty('--spin', value);
      }
      if (inView) {
        loopRaf = requestAnimationFrame(render);
      } else {
        loopRaf = null;
      }
    }

    function startLoop() {
      if (loopRaf == null) loopRaf = requestAnimationFrame(render);
    }

    function stopLoop() {
      if (loopRaf != null) { cancelAnimationFrame(loopRaf); loopRaf = null; }
    }

    // Liga/desliga o loop conforme a medalha entra/sai da tela (economiza CPU/bateria)
    if ('IntersectionObserver' in window) {
      const io = new IntersectionObserver(function (entries) {
        for (let i = 0; i < entries.length; i++) inView = entries[i].isIntersecting;
        if (inView) startLoop(); else stopLoop();
      }, { rootMargin: '200px 0px' });
      io.observe(stage);
    } else {
      inView = true;
      startLoop();
    }

    // Continua girando após soltar (efeito de "roda")
    function inertia() {
      if (dragging) { inertiaRaf = null; return; }
      manualSpin += velocity;
      velocity *= FRICTION;
      startLoop();
      if (Math.abs(velocity) > MIN_VELOCITY) {
        inertiaRaf = requestAnimationFrame(inertia);
      } else {
        velocity = 0;
        inertiaRaf = null;
      }
    }

    function onDown(e) {
      if (e.pointerType === 'mouse' && e.button != null && e.button !== 0) return;
      dragging = true;
      gestureAxis = null;
      velocity = 0;
      startX = e.clientX;
      startY = e.clientY;
      lastX = e.clientX;
      if (inertiaRaf != null) { cancelAnimationFrame(inertiaRaf); inertiaRaf = null; }
      stage.classList.add('is-dragging');
      try { stage.setPointerCapture(e.pointerId); } catch (_) {}
      startLoop();
    }

    function onMove(e) {
      if (!dragging) return;

      // Primeiro movimento: decide se o gesto é girar (horizontal) ou rolar a página (vertical).
      if (gestureAxis === null) {
        const totalDx = e.clientX - startX;
        const totalDy = e.clientY - startY;
        if (Math.hypot(totalDx, totalDy) < DRAG_THRESHOLD) return; // ainda não deu para decidir
        gestureAxis = Math.abs(totalDx) >= Math.abs(totalDy) ? 'x' : 'y';
        // Se o gesto é vertical, solta o controle para a página rolar normalmente (sem girar).
        if (gestureAxis === 'y') {
          dragging = false;
          stage.classList.remove('is-dragging');
          try { if (e.pointerId != null) stage.releasePointerCapture(e.pointerId); } catch (_) {}
          return;
        }
        lastX = e.clientX; // evita um "pulo" no primeiro frame
      }

      if (gestureAxis !== 'x') return; // gesto vertical: deixa a página rolar

      const dx = e.clientX - lastX;
      lastX = e.clientX;
      const deg = dx * DRAG_SENSITIVITY;
      manualSpin += deg;
      // Suaviza a velocidade (média) para a inércia não ficar "nervosa"
      velocity = velocity * 0.6 + deg * 0.4;
      startLoop();
    }

    function onUp(e) {
      if (!dragging) return;
      const wasRotating = gestureAxis === 'x';
      dragging = false;
      gestureAxis = null;
      stage.classList.remove('is-dragging');
      try { if (e && e.pointerId != null) stage.releasePointerCapture(e.pointerId); } catch (_) {}
      if (wasRotating && Math.abs(velocity) > MIN_VELOCITY) {
        if (inertiaRaf != null) cancelAnimationFrame(inertiaRaf);
        inertiaRaf = requestAnimationFrame(inertia);
      } else {
        velocity = 0;
      }
    }

    stage.addEventListener('pointerdown', onDown);
    stage.addEventListener('pointermove', onMove);
    stage.addEventListener('pointerup', onUp);
    stage.addEventListener('pointercancel', onUp);
    stage.addEventListener('lostpointercapture', onUp);
    stage.addEventListener('dragstart', function (e) { e.preventDefault(); });

    // Reforço: qualquer scroll/resize garante o loop ligado.
    // O listener vai no documento em FASE DE CAPTURA, então também pega o scroll
    // disparado pelo <body> (o listener no window sozinho não captura nesta página).
    document.addEventListener('scroll', startLoop, { passive: true, capture: true });
    window.addEventListener('resize', startLoop);

    // Botão de virar a medalha (frente <-> verso)
    if (flipBtn) {
      flipBtn.addEventListener('click', function () {
        const flipped = flipper.classList.toggle('is-flipped');
        flipBtn.setAttribute('aria-pressed', flipped ? 'true' : 'false');
        flipBtn.textContent = flipped ? 'Voltar para frente' : 'Virar medalha';
      });
    }

    // Primeira pintura imediata (o loop contínuo cuida das próximas atualizações)
    render();
  })();
</script>
