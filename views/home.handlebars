<section id="inicio" class="hero">
  <div class="hero__content">
    <h1 class="hero__title">
      Trilha do <span class="highlight">JJ</span>
    </h1>
    <p class="hero__subtitle">{{subtitle}}</p>
    <p class="hero__description">{{description}}</p>

    <div class="hero__actions">
      <a href="/inscricao" class="btn btn--primary">Inscreva-se Agora <span class="arrow">→</span></a>
      <a href="#detalhes" class="btn btn--secondary">Saiba Mais</a>
    </div>


  </div>
</section>
<div class="section-divider" aria-hidden="true"></div>

<section id="detalhes" class="section details">
